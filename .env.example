PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/whispr
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:8081
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
ADMIN_EMAIL=admin@example.com
# Prefer ADMIN_PASSWORD_HASH in deployed environments. ADMIN_PASSWORD is server-only and never sent to clients.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=replace-with-a-second-unique-admin-secret-at-least-32-characters
ADMIN_SESSION_EXPIRES_IN=8h
# Server-only Paystack credentials. Never copy the secret key into Expo variables.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack signs webhooks with the secret key unless a separate webhook secret is configured.
PAYSTACK_WEBHOOK_SECRET=
# Optional HTTPS callback used by hosted checkout (for example, https://api.example.com/payment/complete).
PAYSTACK_CALLBACK_URL=
